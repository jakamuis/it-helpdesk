# Local dry-run example. Server uses https://glpi.samator.com/apirest.php.
GLPI_URL=http://localhost:8080/apirest.php
GLPI_APP_TOKEN=your_app_token_here
GLPI_USER_TOKEN=your_user_token_here
GLPI_ENTITY=0
GLPI_VERIFY_TLS=true
API_KEY=your_secure_api_key_here
LOG_LEVEL=INFO
TIMEOUT=10
DATABASE_URL=sqlite:///./data/audit.db
ASSET_SYNC_IMAGE_TAG=1.1.0-local
ASSET_SYNC_PLATFORM=linux/amd64
ASSET_SYNC_BUILD_COMMIT=unknown

# Weekly Google Sheets Sync Schedule (Sunday, 17:00 WIB)
# Docker Compose stages a UID 10001/mode 0400 copy at
# /app/secrets/google-service-account.json and overrides this local path.
GOOGLE_CREDENTIALS_PATH=./data/service_account.json
SPREADSHEET_ID=your_spreadsheet_id_here
SHEET_NAME=DATABASE INVENTARIS
# Fixed policy: only Electronics CPU/Laptop rows map to GLPI Computer.
SYNC_ASSET_TYPES=["Computer"]
SYNC_ENABLED=false
SYNC_DRY_RUN=true
SYNC_FINANCE_ENABLED=false
SYNC_ALLOW_CREATE=false
SYNC_ALLOW_INFOCOM_CREATE=false
SYNC_ALLOW_INFOCOM_UPDATE=false
SYNC_MAX_GLPI_MUTATIONS_PER_RUN=0
SYNC_APPROVED_MANIFEST_SHA256=
SYNC_MANIFEST_DIR=./data/manifests
SYNC_LOCK_DIR=./data/locks
SYNC_DAY_OF_WEEK=sun
SYNC_HOUR=17
SYNC_MINUTE=0
SYNC_TIMEZONE=Asia/Jakarta
