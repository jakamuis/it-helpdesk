# ==========================================
# GLPI REST API Configuration
# ==========================================
# Base URL of your GLPI instance (without trailing slash)
# Example: https://glpi.example.com/apirest.php
GLPI_URL=https://glpi.your-domain.com/apirest.php

# App-Token generated in GLPI (Setup > API)
GLPI_APP_TOKEN=your_glpi_app_token_here

# User-Token generated under GLPI User Profile settings
GLPI_USER_TOKEN=your_glpi_user_token_here


# ==========================================
# Google Sheets API Configuration
# ==========================================
# Spreadsheet ID found in the Google Sheet URL
# Example: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Tab/Sheet name where data should be written
GOOGLE_SHEET_NAME=Tickets

# Path to Service Account credentials JSON file
GOOGLE_CREDENTIALS_FILE=credentials.json


# ==========================================
# AppSheet Direct API Configuration
# ==========================================
# App ID from AppSheet (found under Manage > Integrations > INBOUND WEBHOOKS or URL)
APPSHEET_APP_ID=your_appsheet_app_id_here

# Application Access Key (found under Manage > Integrations > INBOUND WEBHOOKS > Access Key)
APPSHEET_ACCESS_KEY=your_appsheet_access_key_here

# Table name in AppSheet application
APPSHEET_TABLE_NAME=Tickets


# ==========================================
# Sync Service Settings
# ==========================================
# Sync mode: "sheets" (direct Google Sheets update), "appsheet" (AppSheet REST API), or "both"
SYNC_MODE=both

# Default GLPI item type to sync ("Ticket", "Computer", "Monitor", "Printer", etc.)
GLPI_ITEM_TYPE=Ticket

# Max number of records to fetch per run (0 for no limit)
FETCH_LIMIT=100

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
