# ==========================================
# GLPI REST API Configuration
# ==========================================
# Base URL of your GLPI instance (without trailing slash)
# Example: https://glpi.example.com/apirest.php
GLPI_URL=https://glpi.your-domain.com/apirest.php

# App-Token generated in GLPI (Setup > API)
GLPI_APP_TOKEN=your_glpi_app_token_here

# User-Token generated under GLPI User Profile settings
GLPI_USER_TOKEN=your_glpi_user_token_here

# Must match the API key configured on the WAHA service.
WAHA_API_KEY=your_waha_api_key_here


# ==========================================
# Local Docker Compose Secrets
# ==========================================
# Required only when running the local GLPI/WAHA Compose stack.
# Use unique values; do not commit the populated .env file.
GLPI_DB_ROOT_PASSWORD=replace_with_a_strong_local_root_password
GLPI_DB_PASSWORD=replace_with_a_strong_local_glpi_password
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace_with_a_strong_dashboard_password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace_with_a_strong_swagger_password


# ==========================================
# Google Sheets API Configuration
# ==========================================
# Spreadsheet ID found in the Google Sheet URL
# Example: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Tab/Sheet name where data should be written
GOOGLE_SHEET_NAME=Tickets

# Path to Service Account credentials JSON file
GOOGLE_CREDENTIALS_FILE=credentials.json


# ==========================================
# AppSheet Direct API Configuration
# ==========================================
# App ID from AppSheet (found under Manage > Integrations > INBOUND WEBHOOKS or URL)
APPSHEET_APP_ID=your_appsheet_app_id_here

# Application Access Key (found under Manage > Integrations > INBOUND WEBHOOKS > Access Key)
APPSHEET_ACCESS_KEY=your_appsheet_access_key_here

# Table name in AppSheet application
APPSHEET_TABLE_NAME=Tickets


# ==========================================
# Sync Service Settings
# ==========================================
# Sync mode: "sheets" (direct Google Sheets update), "appsheet" (AppSheet REST API), or "both"
SYNC_MODE=both

# Default GLPI item type to sync ("Ticket", "Computer", "Monitor", "Printer", etc.)
GLPI_ITEM_TYPE=Ticket

# Max number of records to fetch per run (0 for no limit)
FETCH_LIMIT=100

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# ==========================================
# AI Triage Service Configuration
# ==========================================
AI_TRIAGE_ENABLED=false
AI_TRIAGE_URL=http://ai-triage:8000
AI_TRIAGE_TIMEOUT_SECONDS=30
AI_CONFIDENCE_THRESHOLD=0.75

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=25
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=256
OLLAMA_COMPACT_MODE=true

CONVERSATION_STATE_TTL_SECONDS=86400
MESSAGE_RETRY_DELAY_SECONDS=30
GLPI_TIMEOUT_SECONDS=15
WAHA_TIMEOUT_SECONDS=10

# When running in Docker, these use the /data persistent volume.
# If running locally without Docker, override these in your environment.
CONVERSATION_STATE_DB_PATH=/data/conversation_state.db
AI_AUDIT_DB_PATH=/data/ai_triage_audit.db
TICKET_MAPPING_FILE=/data/ticket_mapping.json
FOLLOWUP_TRACK_FILE=/data/last_followup.txt
